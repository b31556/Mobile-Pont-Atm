# /etc/pont/env  (owner root, group pont, mode 640). Never commit the real file.
JWT_SECRET=make-one-with-openssl-rand-hex-32
# Only used to create the first admin when the database is empty; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-one
PORT=3000
HOST=127.0.0.1
# The reverse proxy on this machine is the only thing believed about a client's address and https.
TRUST_PROXY=loopback
# Refuse anything that did not arrive over https (except /health).
REQUIRE_HTTPS=1
DB_PATH=/var/lib/pont/pont.db
NODE_ENV=production
