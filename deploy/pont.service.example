[Unit]
Description=Pont server (example unit: adjust the paths)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pont
Group=pont
WorkingDirectory=/opt/pont/current/server
EnvironmentFile=/etc/pont/env
ExecStart=/usr/local/bin/node dist/index.js
Restart=on-failure
RestartSec=3
# The app only needs to read its own code and write its data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pont
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
